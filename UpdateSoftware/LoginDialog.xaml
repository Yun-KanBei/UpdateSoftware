<Window x:Class="UpdateSoftware.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="身份验证"
        Width="400"
        Height="300"
        Icon="/COLIBRI.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        Background="{DynamicResource PrimaryBackgroundColor}"
        Foreground="{DynamicResource PrimaryTextColor}">
    <Window.Resources>
        <!-- 圆角按钮模板 -->
        <ControlTemplate x:Key="DialogButtonTemplate" TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="12,0"
                    Height="{TemplateBinding Height}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="请输入您的身份信息"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <!-- 用户名 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="用户名:" VerticalAlignment="Center" />
            <TextBox x:Name="TxtUserName"
                     Grid.Column="1"
                     Height="34"
                     Padding="8,4"
                     BorderThickness="2"
                     Background="{DynamicResource TertiaryBackgroundColor}"
                     Foreground="{DynamicResource PrimaryTextColor}"
                     BorderBrush="{DynamicResource TertiaryBackgroundColor}"
                     CaretBrush="{DynamicResource PrimaryBlueColor}" />
        </Grid>

        <!-- 密码 -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="密码:" VerticalAlignment="Center" />
            <PasswordBox x:Name="PwdPassword"
                         Grid.Column="1"
                         Height="34"
                         Padding="8,4"
                         BorderThickness="2"
                         Background="{DynamicResource TertiaryBackgroundColor}"
                         Foreground="{DynamicResource PrimaryTextColor}"
                         BorderBrush="{DynamicResource TertiaryBackgroundColor}" />
        </Grid>

        <!-- 错误提示 -->
        <TextBlock Grid.Row="3"
                   x:Name="TxtError"
                   Foreground="{DynamicResource PrimaryRedColor}"
                   FontSize="12"
                   VerticalAlignment="Bottom"
                   Visibility="Collapsed" />

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    Width="90"
                    Height="34"
                    Margin="0,0,12,0"
                    IsCancel="True"
                    Background="{DynamicResource TertiaryBackgroundColor}"
                    Foreground="{DynamicResource PrimaryTextColor}"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"
                    Template="{StaticResource DialogButtonTemplate}" />
            <Button x:Name="BtnLogin"
                    Content="登录"
                    Width="90"
                    Height="34"
                    Background="{DynamicResource PrimaryBlueColor}"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    Cursor="Hand"
                    Click="BtnLogin_Click"
                    Template="{StaticResource DialogButtonTemplate}" />
        </StackPanel>
    </Grid>
</Window>

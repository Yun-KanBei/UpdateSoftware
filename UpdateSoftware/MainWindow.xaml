<Window x:Class="UpdateSoftware.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UpdateSoftware"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="EXE版本工具" Height="750" Width="1200"
        Icon="/COLIBRI.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WindowBg}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource WindowBg}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                MouseRightButtonUp="TitleBar_MouseRightButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 应用图标 + 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Image Source="/COLIBRI.ico" Width="18" Height="18" Margin="0,0,0,0" />
                    <TextBlock Text="EXE版本工具" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource PageText}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 窗口控制按钮（标记为在标题栏中可点击） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 最小化 -->
                    <Button x:Name="BtnMinimize" Width="46" Height="32"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="bd" Background="{TemplateBinding Background}">
                                                <Path Data="M0,0 L10,0" Stroke="{DynamicResource PageText}" StrokeThickness="1.5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 最大化/还原 -->
                    <Button x:Name="BtnMaximize" Width="46" Height="32"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnMaximize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="bd" Background="{TemplateBinding Background}">
                                                <Path x:Name="MaximizeIcon" Data="M0,0 L10,0 L10,10 L0,10 Z"
                                                      Stroke="{DynamicResource PageText}" StrokeThickness="1.5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Width="10" Height="10" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 关闭 -->
                    <Button x:Name="BtnClose" Width="46" Height="32"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="bd" Background="{TemplateBinding Background}">
                                                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource PageText}" StrokeThickness="1.5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#D32F2F"/>
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>

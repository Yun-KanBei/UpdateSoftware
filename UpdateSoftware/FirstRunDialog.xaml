<Window x:Class="UpdateSoftware.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首次运行设置" Height="210" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/COLIBRI.ico"
        FontSize="13"
        Background="{DynamicResource PrimaryBackgroundColor}"
        Foreground="{DynamicResource PrimaryTextColor}">
    <Window.Resources>
        <ControlTemplate x:Key="DialogButtonTemplate" TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="12,0"
                    Height="{TemplateBinding Height}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请选择关闭窗口时的默认行为："
                   FontSize="14"
                   Margin="0,10,0,0"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Orientation="Horizontal" Margin="0,10,0,10">
            <Button x:Name="BtnExit" Width="150" Height="38"
                    Content="结束程序"
                    Margin="0,0,15,0"
                    Click="BtnExit_Click"
                    Background="{DynamicResource TertiaryBackgroundColor}"
                    Foreground="{DynamicResource PrimaryTextColor}"
                    BorderThickness="0"
                    Cursor="Hand"
                    Template="{DynamicResource DialogButtonTemplate}"/>
            <Button x:Name="BtnTray" Width="150" Height="38"
                    Content="最小化到系统托盘"
                    Background="{DynamicResource PrimaryBlueColor}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="15,0,0,0"
                    Click="BtnTray_Click"
                    Template="{DynamicResource DialogButtonTemplate}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="选择后可在「参数设定」页面随时更改"
                   Foreground="{DynamicResource TertiaryTextColor}"
                   FontSize="11"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>
